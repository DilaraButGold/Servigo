generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  veli     Veli?
  sofor    Sofor?
  ogretmen Ogretmen?
}

enum Role {
  ADMIN
  SOFOR
  VELI
  OGRETMEN
}

model Veli {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ogrenciler Ogrenci[]
}

model Sofor {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaka      String
  aracTipi   String?
  kapasite   Int       @default(20)
  ogrenciler Ogrenci[]
  devamsizliklar Devamsizlik[]
  konumGecmisi KonumGecmisi[]
  servisSeferleri ServisSeferi[]
  yoklamalar    Yoklama[]        // YENİ: şoförün yaptığı yoklamalar
}

model Ogretmen {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sinif      String?
}

model Ogrenci {
  id         String    @id @default(cuid())
  ad         String
  soyad      String
  sinif      String?
  veliId     String
  veli       Veli      @relation(fields: [veliId], references: [id], onDelete: Cascade)
  soforId    String?
  sofor      Sofor?    @relation(fields: [soforId], references: [id])
  adres      String
  mesafeKm   Float
  aylikUcret Float
  aktif      Boolean   @default(true)
  devamsizliklar Devamsizlik[]
  odemeler      Odeme[]
  qrKod         String?   @unique   // YENİ: benzersiz QR kod metni
  yoklamalar    Yoklama[]           // YENİ: öğrencinin yoklamaları

  @@index([veliId])
  @@index([soforId])
}

model Devamsizlik {
  id        String   @id @default(cuid())
  ogrenciId String
  ogrenci   Ogrenci  @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)
  soforId   String?
  sofor     Sofor?   @relation(fields: [soforId], references: [id])
  tarih     DateTime @default(now())
  neden     String?
  gecikmeDk Int?
  tip       DevamsizlikTipi
  createdAt DateTime @default(now())
}

enum DevamsizlikTipi {
  GELMIYOR
  GEC_KALACAK
  ERKEN_CIKIS
}

model KonumGecmisi {
  id        String   @id @default(cuid())
  soforId   String
  sofor     Sofor    @relation(fields: [soforId], references: [id], onDelete: Cascade)
  enlem     Float
  boylam    Float
  hiz       Float?
  yon       Float?
  createdAt DateTime @default(now())

  @@index([soforId])
  @@index([createdAt])
}

model ServisSeferi {
  id          String   @id @default(cuid())
  soforId     String
  sofor       Sofor    @relation(fields: [soforId], references: [id])
  baslangic   DateTime @default(now())
  bitis       DateTime?
  rotaJson    Json?
  aktif       Boolean  @default(true)

  @@index([soforId, aktif])
}

model AylikUcretKurali {
  id             String   @id @default(cuid())
  kmBasinaFiyat  Float
  minimumUcret   Float
  guncellenmeTarihi DateTime @default(now())
}

model Odeme {
  id            String      @id @default(cuid())
  ogrenciId     String
  ogrenci       Ogrenci     @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)
  tutar         Float
  ay            Int
  yil           Int
  durum         OdemeDurum
  odemeTipi     OdemeTipi
  islemId       String?
  makbuzUrl     String?
  odenmeTarihi  DateTime?
  createdAt     DateTime    @default(now())
}

enum OdemeDurum {
  BEKLIYOR
  ODENDI
  GECIKTI
}

enum OdemeTipi {
  ONLINE
  MANUEL
}

// YENİ: Yoklama (QR/NFC ile biniş/inme)
model Yoklama {
  id          String       @id @default(cuid())
  ogrenciId   String
  ogrenci     Ogrenci      @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)
  soforId     String?
  sofor       Sofor?       @relation(fields: [soforId], references: [id])
  tip         YoklamaTipi
  konum       Json?        // { enlem, boylam } opsiyonel
  createdAt   DateTime     @default(now())

  @@index([ogrenciId])
  @@index([soforId])
}

enum YoklamaTipi {
  BINIS
  INIS
}