generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  veli     Veli?
  sofor    Sofor?
  ogretmen Ogretmen?
}

enum Role {
  ADMIN
  SOFOR
  VELI
  OGRETMEN
}

model Veli {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ogrenciler Ogrenci[]
}

model Sofor {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaka      String
  aracTipi   String?
  kapasite   Int       @default(20)
  ogrenciler Ogrenci[]
  devamsizliklar Devamsizlik[]   // Şoföre ait devamsızlık bildirimleri 
  konumGecmisi KonumGecmisi[]  
  servisSeferleri ServisSeferi[] 
}

model Ogretmen {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sinif      String?
}

model Ogrenci {
  id         String    @id @default(cuid())
  ad         String
  soyad      String
  sinif      String?
  veliId     String
  veli       Veli      @relation(fields: [veliId], references: [id], onDelete: Cascade)
  soforId    String?
  sofor      Sofor?    @relation(fields: [soforId], references: [id])
  adres      String
  mesafeKm   Float
  aylikUcret Float
  aktif      Boolean   @default(true)
  devamsizliklar Devamsizlik[]   // Öğrencinin devamsızlık kayıtları

  @@index([veliId])
  @@index([soforId])
}

model Devamsizlik {
  id        String   @id @default(cuid())
  ogrenciId String
  ogrenci   Ogrenci  @relation(fields: [ogrenciId], references: [id], onDelete: Cascade)
  soforId   String?
  sofor     Sofor?   @relation(fields: [soforId], references: [id])
  tarih     DateTime @default(now())
  neden     String?
  gecikmeDk Int?
  tip       DevamsizlikTipi
  createdAt DateTime @default(now())
}

enum DevamsizlikTipi {
  GELMIYOR
  GEC_KALACAK
  ERKEN_CIKIS
} 


model KonumGecmisi {
  id        String   @id @default(cuid())
  soforId   String
  sofor     Sofor    @relation(fields: [soforId], references: [id], onDelete: Cascade)
  enlem     Float
  boylam    Float
  hiz       Float?     // km/sa
  yon       Float?     // derece
  createdAt DateTime @default(now())

  @@index([soforId])
  @@index([createdAt])
}

model ServisSeferi {
  id          String   @id @default(cuid())
  soforId     String
  sofor       Sofor    @relation(fields: [soforId], references: [id])
  baslangic   DateTime @default(now())
  bitis       DateTime?
  rotaJson    Json?     // durak listesi koordinatları
  aktif       Boolean  @default(true)

  @@index([soforId, aktif])
}