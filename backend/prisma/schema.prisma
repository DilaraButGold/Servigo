generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?  @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  SOFOR
  VELI
  OGRETMEN
}